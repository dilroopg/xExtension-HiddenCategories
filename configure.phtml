<?php
declare(strict_types=1);

/**
 * Hidden Categories — settings.
 *
 * Shape: one list of categories, hidden rows first, one button per row. Mode is
 * a single control. Everything diagnostic is collapsed into <details>.
 *
 * Deliberately NOT: a wall of prose, four rival sections, or timestamps in the
 * default view. If a line here is not a control or a count, it lives in Details.
 *
 * @var HiddenCategoriesExtension $this
 */

$store = $this->store();
$storeOk = $store->assertSchema();
$mode = $store->mode();
$labels = $this->modeLabels();
$hidden = $store->hiddenCategories();
$hiddenIds = [];
foreach ($hidden as $h) {
	$hiddenIds[$h['cat_id']] = true;
}
$problems = $storeOk ? $store->invariantProblems() : [];
$csrf = FreshRSS_Auth::csrfToken();
$url = _url('extension', 'configure', 'e', urlencode($this->getName()));

// the same three-state control as the sidebar button, so the page and the
// button can never disagree about what "next click" means
$view = $store->view();
$nextView = $store->nextView();
$viewLabels = [
	'hidden' => ['Show', 'Reveal the hidden categories in the sidebar'],
	'revealed' => ['Show all', 'Show only the hidden categories, hide the rest'],
	'only' => ['Hide', 'Go back to hiding them'],
];
$viewLabel = [
	'hidden' => 'hidden',
	'revealed' => 'revealed',
	'only' => 'only hidden',
][$view] ?? 'hidden';
$nextViewLabel = $viewLabels[$nextView][0] ?? 'Show';
$nextViewTitle = $viewLabels[$nextView][1] ?? '';

// the lock card: passcode shown in plain text by design (it is the owner's own
// code and the page is the escape hatch when it is forgotten)
$passcode = $store->passcode();
$locked = $store->isLocked();

$cats = $this->categories();
$hiddenRows = [];
$visibleRows = [];
foreach ($cats as $c) {
	if (isset($hiddenIds[$c['id']])) {
		$hiddenRows[] = $c;
	} else {
		$visibleRows[] = $c;
	}
}
$totalFeeds = 0;
foreach ($cats as $c) {
	$totalFeeds += $c['feeds'];
}

/** One row: dot, name, feed count, [Hide|Show] */
$row = static function (array $c, bool $isHidden) use ($url, $csrf): void {
	?>
	<div class="hc-row<?= $isHidden ? ' hc-is-hidden' : '' ?>">
		<span class="hc-dot" aria-hidden="true"><?= $isHidden ? '&#9679;' : '&#9675;' ?></span>
		<span class="hc-name" title="<?= htmlspecialchars($c['name'], ENT_QUOTES) ?>"><?= htmlspecialchars($c['name'], ENT_QUOTES) ?></span>
		<span class="hc-feeds"><?= $c['feeds'] ?> <?= $c['feeds'] === 1 ? 'feed' : 'feeds' ?></span>
		<form method="post" action="<?= $url ?>">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="<?= $isHidden ? 'unhide' : 'hide' ?>" />
			<input type="hidden" name="cat" value="<?= $c['id'] ?>" />
			<button class="hc-act" type="submit" title="<?= $isHidden ? 'Show this category again' : 'Hide this category' ?>"><?= $isHidden ? 'Show' : 'Hide' ?></button>
		</form>
	</div>
	<?php
};
?>
<div id="hidden-categories-config" class="hidden-categories">

	<?php if (!$storeOk) { ?>
		<p class="alert alert-error">
			The extension cannot reach its own settings file, so hiding is unavailable:
			<?= htmlspecialchars($store->error(), ENT_QUOTES) ?>
		</p>
	<?php } ?>
	<?php if ($store->notice() !== '') { ?>
		<p class="alert alert-warn"><?= htmlspecialchars($store->notice(), ENT_QUOTES) ?></p>
	<?php } ?>
	<?php foreach ($problems as $p) { ?>
		<p class="alert alert-error"><?= htmlspecialchars($p, ENT_QUOTES) ?></p>
	<?php } ?>

	<?php if ($hiddenRows === []) { ?>
		<div class="hc-empty">
			<strong>Nothing is hidden.</strong><br />
			Press <em>Hide</em> next to a category below. Hiding is temporary and one click away
			from being undone — nothing is ever deleted or renamed.
		</div>
	<?php } else { ?>
		<div class="hc-group-label">Hidden &middot; <?= count($hiddenRows) ?></div>
		<div class="hc-list">
			<?php foreach ($hiddenRows as $c) { $row($c, true); } ?>
		</div>
	<?php } ?>

	<div class="hc-group-label">Categories &middot; <?= count($visibleRows) ?> visible of <?= count($cats) ?></div>
	<div class="hc-list">
		<?php foreach ($visibleRows as $c) { $row($c, false); } ?>
		<?php if ($visibleRows === []) { ?>
			<div class="hc-empty">Every category is hidden.</div>
		<?php } ?>
	</div>

	<div class="hc-group-label">Mode</div>
	<form method="post" action="<?= $url ?>" id="hidden-categories-mode-form" class="hc-mode-form">
		<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
		<input type="hidden" name="act" value="mode" />
		<label class="hc-mode-opt" title="Nothing is written to your feeds. Filtered in the browser; the API and clients without JavaScript still see everything.">
			<input type="radio" name="mode" value="light" <?= $mode === 'light' ? 'checked' : '' ?> />
			Light <span class="hc-hint">&mdash; visual only, writes nothing</span>
		</label>
		<label class="hc-mode-opt" title="Feeds in hidden categories get FreshRSS's own 'only show in this category' setting. The previous value is saved, and restored when you unhide or switch the extension off.">
			<input type="radio" name="mode" value="strict" <?= $mode === 'strict' ? 'checked' : '' ?> />
			Strict <span class="hc-hint">&mdash; filters for every client</span>
		</label>
		<button class="btn btn-important" type="submit">Save</button>
	</form>

	<div class="hc-group-label">Sidebar</div>
	<?php
	// Say plainly where the right-click item comes from. It is not ours: this
	// extension only appends an item to the menu RightClickActions builds, so
	// without that extension there is no menu to append to. Documented in the
	// README since the first release, but the README is not where someone looks
	// after right-clicking and finding nothing.
	// Read the user's own enabled list rather than Minz_ExtensionManager: the
	// manager only answers after its init() has run, and that list is keyed by
	// the extension's *name* ("Right-Click Actions"), not its entrypoint — so
	// asking for the entrypoint silently answers "no" and the panel would claim
	// an installed extension is missing. The config array is always available.
	$rcaInstalled = false;
	try {
		$enabled = FreshRSS_Context::userConf()->extensions_enabled;
		if (is_array($enabled)) {
			// Enabled keys are extension *names*. Right Click Actions' name varies by
			// build/version ("Right Click Actions - Feed Settings Panel", "Right-Click
			// Actions", "RightClickActions"), so match on the name prefix too.
			foreach (['Right Click Actions - Feed Settings Panel', 'Right-Click Actions', 'RightClickActions'] as $rcaName) {
				if (!empty($enabled[$rcaName])) { $rcaInstalled = true; break; }
			}
			if (!$rcaInstalled) {
				foreach ($enabled as $rcaKey => $rcaOn) {
					if ($rcaOn && stripos((string)$rcaKey, 'right') !== false && stripos((string)$rcaKey, 'click') !== false) {
						$rcaInstalled = true;
						break;
					}
				}
			}
		}
	} catch (Throwable $e) {
		// no user config in this render: say nothing rather than guess
		$rcaInstalled = false;
	}
	?>
	<div class="hc-lock-card hc-rca-card">
		<p class="hc-hint">
			<span class="hc-rca-title">Right click menu</span>
		</p>
		<p class="hc-hint">
			<?php if ($rcaInstalled) { ?>
				<strong>Right Click Actions - Feed Settings Panel is installed.</strong> Right-clicking a
				category in the sidebar shows <em>Hide category</em> / <em>Unhide category</em>.
			<?php } else { ?>
				<strong>Needs the Right Click Actions - Feed Settings Panel extension.</strong> This
				extension adds a <em>Hide category</em> / <em>Unhide category</em> item to the sidebar's
				right-click menu — but that menu belongs to
				<a href="https://github.com/printfuck/xExtension-RightClickActions" target="_blank" rel="noopener">Right Click Actions - Feed Settings Panel</a>,
				not to this extension. <strong>Without it installed FreshRSS has no right-click
				menu at all</strong>, so there is nothing to add the item to. Every other way of
				hiding — <em>Hide</em> on each row above, the button under <em>Subscription
				management</em>, and the eye above the sidebar — works either way.
			<?php } ?>
		</p>
	</div>

	<?php
	$showCount = $store->showCount();
	$rowLabel = $store->rowLabel();
	$modeRow = $store->rowMode();
	$hiddenN = count($hiddenRows);
	// The saved state, drawn from the same three pieces hidden.js draws, so
	// this cannot drift from the real row.
	$rowPreviewText = $modeRow === 'caret'
		? ''
		: ($modeRow === 'both' && $rowLabel !== ''
			? $rowLabel . ' ' . $hiddenN
			: (string)$hiddenN);
?>
	<div class="hc-lock-card">
		<p class="hc-hint">
			How the hidden row in the sidebar tree labels itself. Display only — nothing about
			what is hidden, the eye button, or the lock.
		</p>

		<?php // the saved state, drawn as the real row: this is the confirmation that a change landed ?>
		<div class="hc-preview">
			<span class="hc-preview-cap">Now reads</span>
			<span class="hc-preview-row">
				<span class="hc-caret" aria-hidden="true">&#9662;</span>
				<?php if ($rowPreviewText === '') { ?>
					<span class="hc-preview-none">just the caret &nbsp;&mdash; nothing else</span>
				<?php } elseif ($modeRow === 'both' && $rowLabel !== '') { ?>
					<span class="hc-row-label"><?= htmlspecialchars($rowLabel, ENT_QUOTES) ?></span>
					<span class="hc-row-num"><?= $hiddenN ?></span>
				<?php } else { ?>
					<span class="hc-row-num"><?= $hiddenN ?></span>
				<?php } ?>
			</span>
		</div>

		<?php
		// One form, one Save button, three display states. This was a checkbox
		// (count on/off), which could not express "label but no number" — the
		// state most people want when obscuring the row. A radio group says
		// exactly which of the three the row is in, so there is no combination
		// the UI can produce that the model cannot store.
		$modes = [
			'caret' => ['Nothing but the caret', 'the row draws no text at all'],
			'number' => ['The number only', 'how many categories are hidden'],
			'both' => ['Label and number', 'the label, then the number'],
		];
		?>
		<form method="post" action="<?= $url ?>" id="hidden-categories-display-form">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="display" />

			<div class="hc-modes" role="radiogroup" aria-label="What the sidebar row shows">
				<?php foreach ($modes as $val => [$title, $sub]) { ?>
					<label class="hc-mode-radio">
						<input type="radio" name="rowmode" value="<?= $val ?>"
							<?= $modeRow === $val ? 'checked' : '' ?> data-hc-rowmode />
						<span>
							<strong><?= $title ?></strong>
							<em><?= $sub ?></em>
						</span>
					</label>
				<?php } ?>
			</div>

			<label class="hc-label-field">
				<span>Label text (used by "Label and number")</span>
				<input type="text" name="label" class="hc-label-input"
					value="<?= htmlspecialchars($rowLabel, ENT_QUOTES) ?>"
					placeholder="leave empty for the number on its own"
					maxlength="40" autocomplete="off" data-hc-label />
			</label>

			<div class="hc-save-bar">
				<button class="btn btn-important" type="submit" data-hc-save>Save</button>
				<span class="hc-dirty" data-hc-dirty aria-live="polite"></span>
			</div>
		</form>

		<div class="hc-live" aria-live="polite">
			<span class="hc-live-cap">After saving</span>
			<span class="hc-preview-row" data-hc-live>
				<span class="hc-caret" aria-hidden="true">&#9662;</span>
				<?php if ($modeRow === 'both') { ?>
					<span class="hc-row-label"><?= htmlspecialchars($rowLabel, ENT_QUOTES) ?></span>
					<span class="hc-row-num"><?= $hiddenN ?></span>
				<?php } elseif ($modeRow === 'number') { ?>
					<span class="hc-row-num"><?= $hiddenN ?></span>
				<?php } ?>
			</span>
			<span class="hc-live-msg" data-hc-live-msg>unchanged</span>
		</div>
	</div>

	<div class="hc-actions">
		<?php if ($hiddenRows !== [] ) { ?>
			<form method="post" action="<?= $url ?>">
				<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
				<input type="hidden" name="act" value="view" />
				<input type="hidden" name="to" value="<?= $nextView ?>" />
				<button class="btn" type="submit" title="<?= htmlspecialchars($nextViewTitle, ENT_QUOTES) ?>">
					<?= htmlspecialchars($nextViewLabel, ENT_QUOTES) ?>
				</button>
			</form>
			<span class="hc-hint">Currently: <strong><?= htmlspecialchars($viewLabel, ENT_QUOTES) ?></strong></span>
		<?php } ?>
		<form method="post" action="<?= $url ?>">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="restore" />
			<button class="btn" type="submit" title="Put back anything this extension changed. Safe to press any number of times.">Restore everything now</button>
		</form>
	</div>

	<div class="hc-group-label">Lock</div>
	<div class="hc-lock-card">
		<p class="hc-hint">
			A speed bump, not security: it stops someone clicking the eye and seeing what
			you hid. It does not hide anything from <em>Subscription management</em>, which
			always lists every feed.
		</p>

		<form method="post" action="<?= $url ?>" class="hc-lock-form">
			<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
			<input type="hidden" name="act" value="passcode" />
			<label for="hc-passcode">Passcode</label>
			<input type="text" id="hc-passcode" name="passcode" class="hc-passcode"
				value="<?= htmlspecialchars($passcode, ENT_QUOTES) ?>"
				placeholder="leave empty to disable the lock" autocomplete="off" />
			<button class="btn" type="submit">Save passcode</button>
			<span class="hc-hint">Shown as plain text on purpose — you can always read or
				change it here, even while locked.</span>
		</form>

		<div class="hc-lock-row">
			<span>Status: <strong><?= $locked ? 'locked' : ($passcode !== '' ? 'unlocked' : 'no passcode set') ?></strong></span>
			<form method="post" action="<?= $url ?>">
				<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
				<input type="hidden" name="act" value="lock" />
				<button class="btn" type="submit" <?= ($passcode === '' || $locked) ? 'disabled="disabled"' : '' ?>>Lock now</button>
			</form>
			<form method="post" action="<?= $url ?>">
				<input type="hidden" name="_csrf" value="<?= $csrf ?>" />
				<input type="hidden" name="act" value="unlock" />
				<input type="hidden" name="code" value="<?= htmlspecialchars($passcode, ENT_QUOTES) ?>" />
				<button class="btn" type="submit" <?= $locked ? '' : 'disabled="disabled"' ?>>Unlock now</button>
			</form>
			<span class="hc-hint">Unlock from here never asks for the code — this page is the
				way back in if you forget it.</span>
		</div>
	</div>

	<details class="hc-details">
		<summary>Details</summary>
		<dl>
			<dt>Mode</dt><dd><?= htmlspecialchars($labels[$mode] ?? $mode, ENT_QUOTES) ?></dd>
			<dt>Hidden</dt><dd><?= count($hiddenRows) ?> of <?= count($cats) ?> categories
				&middot; <?= $totalFeeds ?> feeds total</dd>
			<dt>Feeds enforced</dt><dd><?= $store->snapshotCount() ?><?= $mode === 'strict' ? '' : ' (light mode never writes to feeds)' ?></dd>
			<dt>On since</dt><dd><?= htmlspecialchars($store->getMeta('first_enabled_at', '—'), ENT_QUOTES) ?></dd>
			<dt>Last disabled</dt><dd><?= htmlspecialchars($store->getMeta('last_disabled_at', 'never'), ENT_QUOTES) ?></dd>
			<dt>Storage</dt><dd><code><?= htmlspecialchars($store->path(), ENT_QUOTES) ?></code><?= $storeOk ? ' &middot; ' . htmlspecialchars($store->integrity(), ENT_QUOTES) : '' ?></dd>
			<dt>Switching off</dt><dd>Runs this extension's own restore first, then disables it. If the restore cannot finish, the extension stays enabled and says why. Mode and hidden set are kept while it is off.</dd>
			<dt>Never touched</dt><dd>Categories are not deleted or renamed, feeds are not moved, nothing is marked read, and other extensions' feed settings are left alone.</dd>
		</dl>
	</details>
</div>
